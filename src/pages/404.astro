
---
import Layout from '../layouts/Layout.astro';

const title = 'Nie znaleziono strony | Kancelaria Notarialna Zbigniew Władysławski';
---

<Layout title={title}>
  <main class="error-page">
    <section class="error-content" aria-labelledby="error-heading">

      <span class="error-code">404</span>

      <p class="error-eyebrow">
        KANCELARIA NOTARIALNA
      </p>

      <h1 id="error-heading">
        Strona nie została<br class="desktop-break" /> znaleziona
      </h1>

      <p class="error-description">
        Przepraszamy, ale strona, której szukasz, nie istnieje,
        została przeniesiona lub jej adres jest nieprawidłowy.
      </p>

      <div class="error-return-wrap">
        <a href={import.meta.env.BASE_URL} class="error-return-link">
          <span class="error-return-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M19 12H5" />
              <path d="m12 19-7-7 7-7" />
            </svg>
          </span>

          <span class="error-return-label">
            Powrót do strony głównej
          </span>
        </a>
      </div>

      <div class="error-decoration bottom-decoration" aria-hidden="true">
        <span class="decoration-line"></span>
        <span class="decoration-diamond"></span>
        <span class="decoration-line"></span>
      </div>

      <p class="error-signature">
        Kancelaria Notarialna<br />
        <strong>Zbigniew Władysławski</strong><br />
        <span>Notariusz</span>
      </p>

    </section>
  </main>
</Layout>

<style>
  .error-page {
    box-sizing: border-box;
    width: 100%;
    min-height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 90px 24px 100px;
    color: var(--text-secondary);
  }

  .error-content {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  /* Numer błędu */

  .error-code {
    display: block;
    font-family: var(--font-main-heading);
    font-size: clamp(100px, 17vw, 170px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.025em;
    color: var(--brand-burgundy);
    opacity: 0.92;
    margin-bottom: 22px;
  }

  /* Mały podpis */

  .error-eyebrow {
    font-family: var(--font-main-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--brand-gold-dark);
    margin: 0 0 20px;
  }

  /* Główny nagłówek */

  .error-content h1 {
    font-family: var(--font-main-heading);
    font-size: clamp(29px, 4vw, 42px);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    margin: 0 0 22px;
  }

  /* Opis */

  .error-description {
    max-width: 570px;
    margin: 0 auto;
    font-family: var(--font-main-body);
    font-size: 15px;
    font-weight: var(--weight-regular);
    line-height: 1.9;
    color: var(--text-secondary);
  }

  /* =========================================
     PRZYCISK POWROTU — STYL JAK W POLITYCE
     ========================================= */

  .error-return-wrap {
    display: flex;
    justify-content: center;
    margin: 36px auto 20px;
    width: fit-content;
    max-width: 100%;
  }

  .error-return-link {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;

    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 0 30px;

    overflow: hidden;

    background: var(--brand-burgundy);
    border: 1px solid rgba(var(--brand-gold-rgb), 0.65);
    border-radius: 999px;

    color: #f7f3eb;
    font-family: var(--font-top-navbar);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.045em;

    text-decoration: none;
    white-space: nowrap;

    transition:
      color 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease,
      transform 250ms ease;
  }

  .error-return-link span {
    text-shadow: none;
  }

  .error-return-icon {
    display: flex;
    width: 18px;
    height: 18px;

    flex-shrink: 0;
    align-items: center;
    justify-content: center;

    color: var(--brand-gold);

    transition:
      color 250ms ease,
      transform 250ms ease;
  }

  .error-return-icon svg {
    display: block;
    width: 16px;
    height: 16px;
    filter: none;
  }

  .error-return-label {
    position: relative;
    display: inline-block;
  }

  /* Złota linia pod napisem */

  .error-return-label::after {
    content: "";

    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;

    height: 1px;
    border-radius: 999px;

    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--brand-gold-rgb), 0.9) 22%,
      var(--brand-gold) 50%,
      rgba(var(--brand-gold-rgb), 0.9) 78%,
      transparent
    );

    box-shadow: 0 0 3px rgba(var(--brand-gold-rgb), 0.16);

    transform: scaleX(0);
    transform-origin: center;

    transition:
      transform 280ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  /* HOVER — URZĄDZENIA Z MYSZĄ */

  @media (hover: hover) and (pointer: fine) {
    .error-return-link:hover {
      color: var(--brand-gold);
      border-color: var(--brand-gold);
      box-shadow: 0 0 12px rgba(var(--brand-gold-rgb), 0.18);
      transform: translateY(-1px);
    }

    .error-return-link:hover .error-return-icon {
      color: var(--brand-gold);
      transform: translateX(-3px);
    }

    .error-return-link:hover .error-return-label::after {
      transform: scaleX(1);
    }
  }

  /* DOTYK */

  @media (hover: none), (pointer: coarse) {
    .error-return-link {
      transition:
        color 120ms ease,
        border-color 120ms ease;
    }

    .error-return-link:active {
      color: var(--brand-gold);
      border-color: var(--brand-gold);
    }

    .error-return-link:active .error-return-icon {
      color: var(--brand-gold);
    }
  }

  /* FOCUS — DOSTĘPNOŚĆ */

  .error-return-link:focus-visible {
    outline: 2px solid var(--brand-gold);
    outline-offset: 4px;
  }

  /* OZDOBNIK */

  .error-decoration {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  .decoration-line {
    display: block;
    width: 55px;
    height: 1px;
    background: rgba(var(--brand-gold-rgb), 0.8);
  }

  .decoration-diamond {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--brand-gold);
    transform: rotate(45deg);
  }

  .bottom-decoration {
    margin-top: 45px;
    margin-bottom: 25px;
  }

  /* PODPIS KANCELARII */

  .error-signature {
    margin: 0;
    font-family: var(--font-main-body);
    font-size: 12px;
    line-height: 1.9;
    letter-spacing: 0.025em;
    color: var(--text-secondary);
  }

  .error-signature strong {
    font-family: var(--font-main-heading);
    font-size: 16px;
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }

  .error-signature span {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--brand-gold-dark);
  }

  /* TABLETY */

  @media (max-width: 767px) {
    .error-page {
      min-height: 65vh;
      padding: 75px 24px 85px;
    }

    .error-content h1 {
      font-size: 32px;
    }

    .error-description {
      font-size: 14px;
    }
  }

  /* RESPONSYWNOŚĆ PRZYCISKU */

  @media (min-width: 768px) {
    .error-return-link {
      gap: 11px;
      padding-inline: 30px;
      font-size: 14px;
    }

    .error-return-icon {
      width: 20px;
      height: 20px;
    }

    .error-return-icon svg {
      width: 17px;
      height: 17px;
    }
  }

  @media (min-width: 1024px) {
    .error-return-link {
      font-size: 15px;
      letter-spacing: 0.05em;
    }
  }

  /* TELEFONY */

  @media (max-width: 480px) {
    .error-page {
      min-height: 60vh;
      padding: 65px 20px 75px;
    }

    .error-code {
      font-size: 112px;
      margin-bottom: 18px;
    }

    .error-eyebrow {
      font-size: 10px;
      letter-spacing: 0.18em;
    }

    .error-content h1 {
      font-size: 28px;
      line-height: 1.4;
    }

    .desktop-break {
      display: none;
    }

    .error-description {
      font-size: 13px;
      line-height: 1.8;
    }

    .error-return-wrap {
      margin-top: 28px;
    }

    .error-return-link {
      gap: 8px;
      padding-inline: 22px;
      font-size: 12px;
      letter-spacing: 0.025em;
    }

    .error-return-icon {
      width: 17px;
      height: 17px;
    }

    .error-return-icon svg {
      width: 15px;
      height: 15px;
    }

    .bottom-decoration {
      margin-top: 38px;
    }
  }

  /* BARDZO WĄSKIE TELEFONY */

  @media (max-width: 359px) {
    .error-code {
      font-size: 96px;
    }

    .error-content h1 {
      font-size: 25px;
    }

    .error-page {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  /* OGRANICZENIE ANIMACJI */

  @media (prefers-reduced-motion: reduce) {
    .error-return-link,
    .error-return-link *,
    .error-return-link *::before,
    .error-return-link *::after {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
  }
</style>
