
---
import Layout from '../layouts/Layout.astro';

const title = 'Nie znaleziono strony | Kancelaria Notarialna Zbigniew Władysławski';
---

<Layout title={title}>
  <main class="error-page">
    <section class="error-content" aria-labelledby="error-heading">

      <div class="error-decoration" aria-hidden="true">
        <span class="decoration-line"></span>
        <span class="decoration-diamond"></span>
        <span class="decoration-line"></span>
      </div>

      <span class="error-code">404</span>

      <p class="error-eyebrow">
        KANCELARIA NOTARIALNA
      </p>

      <h1 id="error-heading">
        Strona nie została<br class="desktop-break" /> znaleziona
      </h1>

      <p class="error-description">
        Przepraszamy, ale strona, której szukasz, nie istnieje,
        została przeniesiona lub jej adres jest nieprawidłowy.
      </p>

      <div class="error-actions">
        <a href="/" class="button-primary">
          <span>Wróć na stronę główną</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>

        <a href="/#kontakt" class="button-secondary">
          Skontaktuj się z kancelarią
        </a>
      </div>

      <p class="error-help">
        Jeśli potrzebujesz pomocy, zapraszamy do kontaktu.
      </p>

      <div class="error-decoration bottom-decoration" aria-hidden="true">
        <span class="decoration-line"></span>
        <span class="decoration-diamond"></span>
        <span class="decoration-line"></span>
      </div>

      <p class="error-signature">
        Kancelaria Notarialna<br />
        <strong>Zbigniew Władysławski</strong><br />
        <span>Notariusz</span>
      </p>

    </section>
  </main>
</Layout>

<style>
  .error-page {
    box-sizing: border-box;
    width: 100%;
    min-height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 90px 24px 100px;
    color: var(--text-secondary);
  }

  .error-content {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  /* Dekoracyjne separatory */

  .error-decoration {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  .decoration-line {
    display: block;
    width: 55px;
    height: 1px;
    background: rgba(var(--brand-gold-rgb), 0.8);
  }

  .decoration-diamond {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--brand-gold);
    transform: rotate(45deg);
  }

  /* Numer błędu */

  .error-code {
    display: block;
    font-family: var(--font-main-heading);
    font-size: clamp(100px, 17vw, 170px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.025em;
    color: var(--brand-burgundy);
    opacity: 0.92;
    margin-bottom: 22px;
  }

  /* Mały podpis */

  .error-eyebrow {
    font-family: var(--font-main-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--brand-gold-dark);
    margin: 0 0 20px;
  }

  /* Główny nagłówek */

  .error-content h1 {
    font-family: var(--font-main-heading);
    font-size: clamp(29px, 4vw, 42px);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    margin: 0 0 22px;
  }

  /* Opis */

  .error-description {
    max-width: 570px;
    margin: 0 auto;
    font-family: var(--font-main-body);
    font-size: 15px;
    font-weight: var(--weight-regular);
    line-height: 1.9;
    color: var(--text-secondary);
  }

  /* Przyciski */

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
  }

  .button-primary,
  .button-secondary {
    box-sizing: border-box;
    min-height: 52px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 14px 23px;
    font-family: var(--font-main-body);
    font-size: 13px;
    font-weight: var(--weight-medium);
    letter-spacing: 0.015em;
    text-decoration: none;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      transform 220ms ease;
  }

  .button-primary {
    border: 1px solid var(--brand-burgundy);
    background: var(--brand-burgundy);
    color: #fff;
  }

  .button-primary:hover {
    background: var(--brand-burgundy-soft);
    border-color: var(--brand-burgundy-soft);
    transform: translateY(-2px);
  }

  .button-primary svg {
    transition: transform 220ms ease;
  }

  .button-primary:hover svg {
    transform: translateX(3px);
  }

  .button-secondary {
    border: 1px solid rgba(var(--brand-gold-rgb), 0.75);
    background: var(--button-surface);
    color: var(--brand-gold-dark);
  }

  .button-secondary:hover {
    border-color: var(--brand-gold);
    background: #e9ddbf;
    color: var(--brand-gold-dark);
  }

  /* Dodatkowa informacja */

  .error-help {
    margin: 24px 0 0;
    font-family: var(--font-main-body);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-secondary);
    opacity: 0.8;
  }

  /* Podpis kancelarii */

  .bottom-decoration {
    margin-top: 45px;
    margin-bottom: 25px;
  }

  .error-signature {
    margin: 0;
    font-family: var(--font-main-body);
    font-size: 12px;
    line-height: 1.9;
    letter-spacing: 0.025em;
    color: var(--text-secondary);
  }

  .error-signature strong {
    font-family: var(--font-main-heading);
    font-size: 16px;
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }

  .error-signature span {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--brand-gold-dark);
  }

  /* Tablety */

  @media (max-width: 767px) {
    .error-page {
      min-height: 65vh;
      padding: 75px 24px 85px;
    }

    .error-content h1 {
      font-size: 32px;
    }

    .error-description {
      font-size: 14px;
    }
  }

  /* Telefony */

  @media (max-width: 480px) {
    .error-page {
      min-height: 60vh;
      padding: 65px 20px 75px;
    }

    .error-decoration {
      margin-bottom: 25px;
    }

    .error-code {
      font-size: 112px;
      margin-bottom: 18px;
    }

    .error-eyebrow {
      font-size: 10px;
      letter-spacing: 0.18em;
    }

    .error-content h1 {
      font-size: 28px;
      line-height: 1.4;
    }

    .desktop-break {
      display: none;
    }

    .error-description {
      font-size: 13px;
      line-height: 1.8;
    }

    .error-actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 28px;
      gap: 12px;
    }

    .button-primary,
    .button-secondary {
      width: 100%;
      min-height: 50px;
      padding: 13px 15px;
      font-size: 12px;
    }

    .bottom-decoration {
      margin-top: 38px;
    }
  }

  /* Bardzo wąskie telefony */

  @media (max-width: 359px) {
    .error-code {
      font-size: 96px;
    }

    .error-content h1 {
      font-size: 25px;
    }

    .error-page {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  /* Ograniczenie animacji dla użytkowników, którzy tego potrzebują */

  @media (prefers-reduced-motion: reduce) {
    .button-primary,
    .button-secondary,
    .button-primary svg {
      transition: none;
    }
  }
</style>
