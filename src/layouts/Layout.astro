
---
/* =========================================
   PRELOAD FONTÓW PIERWSZEGO EKRANU
   ========================================= */

import merriweatherLatin400 from '@fontsource/merriweather/files/merriweather-latin-400-normal.woff2?url';
import merriweatherLatinExt400 from '@fontsource/merriweather/files/merriweather-latin-ext-400-normal.woff2?url';

import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interLatinExt400 from '@fontsource/inter/files/inter-latin-ext-400-normal.woff2?url';

/* =========================================
   MERRIWEATHER
   ========================================= */

import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/500.css';

/* =========================================
   INTER
   ========================================= */

import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';

/* =========================================
   PARISIENNE
   ========================================= */

import '@fontsource/parisienne/400.css';

/* =========================================
   POZOSTAŁE STYLE
   ========================================= */

import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Kancelaria Notarialna w Olsztynie – Zbigniew Władysławski</title>

    <meta
      name="description"
      content="Kancelaria Notarialna Zbigniewa Władysławskiego w Olsztynie. Czynności notarialne dotyczące nieruchomości, spraw rodzinnych, spadków, testamentów i spółek."
    />

    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://notariusz.wladyslawski.pl/" />

    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}/assets/ZW.png?v=2`}
    />

    <!-- =====================================
         PRELOAD MERRIWEATHER 400
         ===================================== -->

    <link
      rel="preload"
      href={merriweatherLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href={merriweatherLatinExt400}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- =====================================
         PRELOAD INTER 400
         ===================================== -->

    <link
      rel="preload"
      href={interLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href={interLatinExt400}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- =====================================
         SCHEMA.ORG
         ===================================== -->

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "Kancelaria Notarialna Zbigniew Władysławski Notariusz",
        "url": "https://notariusz.wladyslawski.pl/",
        "description": "Kancelaria Notarialna Zbigniewa Władysławskiego w Olsztynie. Czynności notarialne dotyczące nieruchomości, spraw rodzinnych, spadków, testamentów i spółek.",
        "telephone": "+48 89 527 38 39",
        "email": "notariusz@wladyslawski.pl",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "ul. Dąbrowszczaków 21/3",
          "postalCode": "10-540",
          "addressLocality": "Olsztyn",
          "addressCountry": "PL"
        },
        "areaServed": {
          "@type": "City",
          "name": "Olsztyn"
        }
      }
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
