
---
import TitleDivider from '../shared/TitleDivider.astro';
---

<section class="contact-form" data-contact-form-section>
  <!-- HEADER -->
  <div class="text-center">
    <h2
      id="contact-form-title"
      class="contact-form-title mt-2 font-main-heading text-[34px] font-normal tracking-wide text-black md:text-[40px]"
    >
      Formularz kontaktowy
    </h2>

    <div class="contact-form-divider">
      <TitleDivider />
    </div>
  </div>

  <!-- OSTRZEŻENIE NAD FORMULARZEM -->



<p class="mx-auto mt-6 max-w-xl font-main-body text-[12px] leading-5 text-stone-500 md:mt-8">
  Formularz na stronie służy do wstępnego kontaktu. Prosimy o niepodawanie w tym miejscu numerów PESEL ani nieprzesyłanie skanów dokumentów i innych poufnych danych.
</p>




  <!-- FORM -->
  <form
    id="contact-form"
    aria-labelledby="contact-form-title"
    novalidate
    class="contact-form-body mx-auto mt-6 w-full max-w-xl space-y-5 font-main-body md:mt-8 md:space-y-6"
  >
    <!-- HONEYPOT -->
    <div class="honeypot" aria-hidden="true">
      <label for="website">Nie wypełniaj tego pola</label>
      <input
        type="text"
        id="website"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <!-- ERROR SUMMARY -->
    <div
      id="form-error-summary"
      tabindex="-1"
      class="form-error-summary hidden border-l-2 border-red-700 bg-red-50/70 px-5 py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700"
      role="alert"
      aria-labelledby="form-error-title"
    >
      <h3
        id="form-error-title"
        class="font-main-body text-[12px] font-medium uppercase tracking-[0.12em] text-red-800"
      >
        Prosimy o poprawienie formularza
      </h3>

      <p class="mt-2 font-main-body text-[13px] leading-6 text-red-800">
        Sprawdź poniższe pola i uzupełnij wymagane informacje.
      </p>

      <ul
        id="form-error-list"
        class="mt-2 list-inside list-disc space-y-1 font-main-body text-[13px] leading-6 text-red-800"
      ></ul>
    </div>

    <!-- IMIĘ I NAZWISKO -->
    <div>
      <label
        for="name"
        class="mb-2 block font-main-body text-[12px] font-normal uppercase tracking-[0.2em] text-[var(--brand-gold-dark)]"
      >
        Imię i nazwisko
        <span aria-hidden="true" class="text-red-700">*</span>
      </label>

      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Jan Kowalski"
        maxlength="100"
        required
        aria-describedby="name-error"
        class="w-full border border-[#D2C3A8] bg-[#F7F3EB]/90 px-4 py-3 font-main-body text-[17px] font-normal leading-[1.7] text-stone-800 outline-none transition-colors duration-200 placeholder:text-stone-400 hover:border-[var(--brand-gold-dark)] focus:border-[var(--brand-gold-dark)] focus:ring-1 focus:ring-[var(--brand-gold)]/40 md:text-[18px]"
      />

      <p
        id="name-error"
        class="field-error mt-2 hidden font-main-body text-[13px] leading-5 text-red-700"
      ></p>
    </div>

    <!-- ADRES E-MAIL -->
    <div>
      <label
        for="email"
        class="mb-2 block font-main-body text-[12px] font-normal uppercase tracking-[0.2em] text-[var(--brand-gold-dark)]"
      >
        Adres e-mail
        <span aria-hidden="true" class="text-red-700">*</span>
      </label>

      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="jan.kowalski@email.pl"
        required
        aria-describedby="email-error"
        class="w-full border border-[#D2C3A8] bg-[#F7F3EB]/90 px-4 py-3 font-main-body text-[17px] font-normal leading-[1.7] text-stone-800 outline-none transition-colors duration-200 placeholder:text-stone-400 hover:border-[var(--brand-gold-dark)] focus:border-[var(--brand-gold-dark)] focus:ring-1 focus:ring-[var(--brand-gold)]/40 md:text-[18px]"
      />

      <p
        id="email-error"
        class="field-error mt-2 hidden font-main-body text-[13px] leading-5 text-red-700"
      ></p>
    </div>

    <!-- TREŚĆ ZAPYTANIA -->
    <div>
      <label
        for="message"
        class="mb-2 block font-main-body text-[12px] font-normal uppercase tracking-[0.2em] text-[var(--brand-gold-dark)]"
      >
        Treść zapytania
        <span aria-hidden="true" class="text-red-700">*</span>
      </label>

      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength="5000"
        placeholder="W czym możemy Państwu pomóc?"
        required
        aria-describedby="message-error"
        class="w-full resize-y border border-[#D2C3A8] bg-[#F7F3EB]/90 px-4 py-3 font-main-body text-[17px] font-normal leading-[1.85] text-stone-800 outline-none transition-colors duration-200 placeholder:text-stone-400 hover:border-[var(--brand-gold-dark)] focus:border-[var(--brand-gold-dark)] focus:ring-1 focus:ring-[var(--brand-gold)]/40 md:text-[18px] md:leading-[1.9]"
      ></textarea>

      <p
        id="message-error"
        class="field-error mt-2 hidden font-main-body text-[13px] leading-5 text-red-700"
      ></p>
    </div>


  <p class="pt-1 font-main-body text-[12px] leading-5 text-stone-500">
    Pola oznaczone symbolem{" "}
    <span aria-hidden="true" class="text-red-700">*</span>
    {" "}są wymagane. Szczegółowe informacje dotyczące przetwarzania danych
    osobowych znajdują się w naszej{" "}
    <a
      href={`${import.meta.env.BASE_URL}polityka-prywatnosci/`}
      class="underline underline-offset-4 transition-colors hover:text-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-gold-dark)]"
    >
      polityce prywatności
    </a>.
  </p>


    <!-- KOMUNIKAT O SUKCESIE -->
    <div
      id="form-success"
      role="status"
      aria-live="polite"
      class="hidden items-start gap-3 border-l-2 border-[#66866b] bg-[#edf3ec]/80 px-4 py-3 font-main-body text-[14px] font-normal leading-7 text-[#405e46] md:text-[15px]"
    >
      <span
        aria-hidden="true"
        class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[#78977a] bg-[#f7faf5] text-[#527657]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="m5 12 4 4L19 6"></path>
        </svg>
      </span>

      <p class="min-w-0">
        Dziękujemy. Wiadomość została wysłana pomyślnie.
      </p>
    </div>

    <!-- KOMUNIKAT O BŁĘDZIE WYSYŁANIA -->
    <div
      id="form-send-error"
      tabindex="-1"
      role="alert"
      aria-live="assertive"
      class="hidden border-l-2 border-red-700 bg-red-50/70 px-4 py-3 font-main-body text-[14px] font-normal leading-7 text-red-800 md:text-[15px]"
    ></div>

    <!-- PRZYCISK WYSYŁANIA -->
    <div class="pt-1">
      <button
        id="contact-submit"
        type="submit"
        class="group inline-flex w-fit max-w-full items-center justify-center gap-4 border border-[#D2C3A8] bg-[#F7F3EB]/90 px-6 py-3 font-main-body text-[14px] font-normal tracking-wide text-[var(--brand-gold-dark)] transition-colors duration-220 hover:border-[var(--brand-gold-dark)] hover:bg-[#EFE6D6] hover:text-[var(--brand-gold-dark)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand-gold-dark)] disabled:cursor-not-allowed disabled:opacity-50"
      >
        <span id="contact-submit-label">Wyślij zapytanie</span>

        <span
          id="contact-submit-arrow"
          class="text-[var(--brand-gold-dark)] transition-transform duration-250 group-hover:translate-x-1"
          aria-hidden="true"
        >
          →
        </span>
      </button>
    </div>
  </form>
</section>

<style>
  .contact-form-title {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 800ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-form-divider {
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
    transition:
      opacity 500ms ease 250ms,
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 250ms;
  }

  .contact-form-body {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 140ms;
  }

  .contact-form.is-visible .contact-form-title {
    opacity: 1;
    transform: translateY(0);
  }

  .contact-form.is-visible .contact-form-divider {
    opacity: 1;
    transform: scaleX(1);
  }

  .contact-form.is-visible .contact-form-body {
    opacity: 1;
    transform: translateY(0);
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field-error:not(.hidden) {
    display: block;
  }

  .form-error-summary:not(.hidden) {
    display: block;
  }

  #form-success:not(.hidden) {
    display: flex;
  }

  #form-send-error:not(.hidden) {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form-title,
    .contact-form-divider,
    .contact-form-body {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
import { sendEmail } from '../../lib/mail';

const TIMEOUT = 15000;

const form = document.querySelector<HTMLFormElement>('#contact-form');
const section = document.querySelector<HTMLElement>('[data-contact-form-section]');

// Animacja sekcji
if (section) {
  if (
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    !('IntersectionObserver' in window)
  ) {
    section.classList.add('is-visible');
  } else {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        section.classList.add('is-visible');
        observer.disconnect();
      }
    }, { threshold: 0.1 });

    observer.observe(section);
  }
}

if (form) {
  type Field = 'name' | 'email' | 'message';

  const fields = {
    name: form.querySelector<HTMLInputElement>('#name')!,
    email: form.querySelector<HTMLInputElement>('#email')!,
    message: form.querySelector<HTMLTextAreaElement>('#message')!,
  };

  const errors = {
    name: form.querySelector<HTMLElement>('#name-error')!,
    email: form.querySelector<HTMLElement>('#email-error')!,
    message: form.querySelector<HTMLElement>('#message-error')!,
  };

  const summary = form.querySelector<HTMLElement>('#form-error-summary')!;
  const errorList = form.querySelector<HTMLUListElement>('#form-error-list')!;
  const success = form.querySelector<HTMLElement>('#form-success')!;
  const sendError = form.querySelector<HTMLElement>('#form-send-error')!;

  const button = form.querySelector<HTMLButtonElement>('#contact-submit')!;
  const buttonLabel = form.querySelector<HTMLElement>('#contact-submit-label')!;
  const arrow = form.querySelector<HTMLElement>('#contact-submit-arrow')!;

  const order: Field[] = ['name', 'email', 'message'];

  const labels: Record<Field, string> = {
    name: 'Imię i nazwisko',
    email: 'Adres e-mail',
    message: 'Treść zapytania',
  };

  const messages: Record<Field, string> = {
    name: '',
    email: '',
    message: '',
  };

  const visible: Record<Field, boolean> = {
    name: false,
    email: false,
    message: false,
  };

  let submitted = false;
  let isSending = false;

  // Walidacja pól
  function getError(field: Field): string {
    const value = fields[field].value.trim();

    if (field === 'name') {
      if (!value) return 'Prosimy o podanie imienia i nazwiska.';
      if (value.length < 2) return 'Prosimy o wpisanie co najmniej 2 znaków.';
      if (value.length > 100) return 'Imię i nazwisko może mieć maksymalnie 100 znaków.';
    }

    if (field === 'email') {
      if (!value) return 'Prosimy o podanie adresu e-mail.';
      if (!fields.email.validity.valid) return 'Prosimy o podanie prawidłowego adresu e-mail.';
    }

    if (field === 'message') {
      if (!value) return 'Prosimy o wpisanie treści zapytania.';
      if (value.length < 10) return 'Treść zapytania musi zawierać co najmniej 10 znaków.';
      if (value.length > 5000) return 'Treść zapytania może mieć maksymalnie 5000 znaków.';
    }

    return '';
  }

  // Aktualizacja pojedynczego pola
  function updateField(field: Field): boolean {
    const element = fields[field];
    const message = getError(field);
    const show = Boolean(
      message && (element.dataset.touched === 'true' || submitted),
    );

    if (messages[field] === message && visible[field] === show) {
      return false;
    }

    messages[field] = message;
    visible[field] = show;

    element.setAttribute('aria-invalid', String(show));
    element.classList.toggle('!border-red-700', show);
    errors[field].classList.toggle('hidden', !show);
    errors[field].textContent = show ? message : '';

    return true;
  }

  // Podsumowanie błędów
  function updateSummary(): void {
    const fragment = document.createDocumentFragment();
    let hasErrors = false;

    for (const field of order) {
      if (!visible[field]) continue;

      hasErrors = true;

      const item = document.createElement('li');
      const link = document.createElement('a');

      link.href = `#${field}`;
      link.dataset.field = field;
      link.className =
        'underline underline-offset-2 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2';
      link.textContent = `${labels[field]}: ${messages[field]}`;

      item.append(link);
      fragment.append(item);
    }

    errorList.replaceChildren(fragment);
    summary.classList.toggle('hidden', !hasErrors);
  }

  // Walidacja całego formularza
  function validate(): boolean {
    let valid = true;

    for (const field of order) {
      if (updateField(field) && messages[field]) {
        valid = false;
      } else if (messages[field]) {
        valid = false;
      }
    }

    updateSummary();
    return valid;
  }

  // Ukrywanie komunikatów
  function hideMessages(): void {
    success.classList.add('hidden');
    sendError.classList.add('hidden');
    sendError.textContent = '';
  }

  // Stan wysyłania
  function setSending(sending: boolean): void {
    isSending = sending;
    button.disabled = sending;
    button.setAttribute('aria-busy', String(sending));
    buttonLabel.textContent = sending ? 'Wysyłanie...' : 'Wyślij zapytanie';
    arrow.classList.toggle('hidden', sending);
  }

  // Limit czasu wysyłania
  function withTimeout<T>(promise: Promise<T>): Promise<T> {
    return new Promise((resolve, reject) => {
      const timer = window.setTimeout(
        () => reject(new Error('Request timed out')),
        TIMEOUT,
      );

      promise.then(
        value => {
          window.clearTimeout(timer);
          resolve(value);
        },
        error => {
          window.clearTimeout(timer);
          reject(error);
        },
      );
    });
  }

  // Obsługa błędów i interakcji pól
  for (const field of order) {
    const element = fields[field];

    element.addEventListener('blur', () => {
      element.dataset.touched = 'true';

      if (updateField(field) && submitted) {
        updateSummary();
      }
    });

    const handleInput = () => {
      if (
        element.dataset.touched === 'true' ||
        submitted
      ) {
        if (updateField(field) && submitted) {
          updateSummary();
        }
      }
    };

    element.addEventListener('input', handleInput);
    element.addEventListener('change', handleInput);
  }

  // Obsługa kliknięć w podsumowaniu błędów
  errorList.addEventListener('click', event => {
    const target = event.target;

    if (!(target instanceof HTMLAnchorElement)) return;

    const field = target.dataset.field as Field | undefined;
    if (!field || !order.includes(field)) return;

    event.preventDefault();
    fields[field].focus();
    fields[field].scrollIntoView({
      block: 'center',
      behavior: 'smooth',
    });
  });

  // Wysyłanie formularza
  form.addEventListener('submit', async event => {
    event.preventDefault();

    if (isSending) return;

    hideMessages();
    submitted = true;

    if (!validate()) {
      summary.focus();
      return;
    }

    setSending(true);

    try {
      fields.name.value = fields.name.value.trim();
      fields.email.value = fields.email.value.trim();
      fields.message.value = fields.message.value.trim();

      const result = await withTimeout(
        sendEmail(new FormData(form)),
      );

      if (!result.success) {
        throw new Error(
          result.message || 'Nie udało się wysłać wiadomości.',
        );
      }

      form.reset();
      submitted = false;

      for (const field of order) {
        delete fields[field].dataset.touched;
        messages[field] = '';
        visible[field] = false;

        fields[field].setAttribute('aria-invalid', 'false');
        fields[field].classList.remove('!border-red-700');

        errors[field].classList.add('hidden');
        errors[field].textContent = '';
      }

      summary.classList.add('hidden');
      errorList.replaceChildren();

      success.classList.remove('hidden');
      success.scrollIntoView({
        block: 'nearest',
        behavior: 'smooth',
      });

    } catch (error) {
      console.error('Contact form error:', error);

      sendError.textContent =
        error instanceof Error
          ? error.message === 'Request timed out'
            ? 'Przekroczono czas oczekiwania. Spróbuj ponownie.'
            : error.message
          : 'Wystąpił błąd podczas wysyłania wiadomości. Spróbuj ponownie później.';

      sendError.classList.remove('hidden');
      sendError.focus();

    } finally {
      setSending(false);
    }
  });
}
</script>
