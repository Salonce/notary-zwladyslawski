
---
import TitleDivider from '../shared/TitleDivider.astro';

const mapUrl =
  'https://maps.google.com/maps?q=Kancelaria%20Notarialna%20Zbigniew%20W%C5%82adys%C5%82awski%2C%20D%C4%85browszczak%C3%B3w%2021%2C%20Olsztyn&t=m&z=13&output=embed';

const directionsUrl =
  'https://www.google.com/maps/dir/?api=1&destination=Kancelaria%20Notarialna%20Zbigniew%20W%C5%82adys%C5%82awski%2C%20D%C4%85browszczak%C3%B3w%2021%20lok.%203%2C%2010-540%20Olsztyn';
---

<div class="content-column h-full" data-location-section>
  <!-- HEADER -->
  <div class="text-center">
    <h2
      class="location-title mt-2 font-main-heading text-[34px] font-normal tracking-wide text-black md:text-[40px]"
    >
      Lokalizacja
    </h2>

    <div class="location-divider">
      <TitleDivider />
    </div>
  </div>

  <!-- INTRODUCTION -->
  <div
    class="location-introduction mx-auto mt-10 w-full max-w-3xl text-justify font-main-body text-[17px] font-normal leading-[1.85] text-stone-700 md:mt-11 md:text-[18px] md:leading-[1.9]"
  >
    <p>
      Kancelaria mieści się w dogodnym punkcie w centrum Olsztyna,
      w odległości ok. 600 metrów od dworca PKP/PKS, w sąsiedztwie
      siedziby Starostwa Olsztyńskiego oraz Sądu Gospodarczego
      w Olsztynie - KRS.
    </p>

    <p class="mt-4 text-[13px] leading-[1.7] text-stone-500 md:text-[14px]">
      W uzasadnionych przypadkach istnieje możliwość dokonania
      czynności notarialnych również poza kancelarią, zgodnie
      z wymogami ustawy Prawo o notariacie.
    </p>
  </div>

  <!-- GOOGLE MAP -->
  <div class="location-map mx-auto mt-7 w-full max-w-3xl md:mt-8">
    <div
      class="overflow-hidden rounded-md border border-[var(--brand-gold)]/70 shadow-[0_4px_16px_rgba(80,65,35,0.09)]"
    >
      <iframe
        src={mapUrl}
        class="block h-[230px] w-full border-0 md:h-[290px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        title="Mapa do Kancelarii Notarialnej Zbigniewa Władysławskiego w Olsztynie"
      ></iframe>
    </div>
  </div>

  <!-- ADDRESS + DIRECTIONS -->
  <div class="location-footer mx-auto mt-5 w-full max-w-3xl pt-1">
    <div
      class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <!-- ADDRESS -->
      <div class="text-center sm:text-left">
        <p
          class="font-main-body text-[10px] font-normal uppercase tracking-[0.18em] text-[var(--brand-gold-dark)]"
        >
          Adres kancelarii
        </p>

        <p
          class="mt-1 font-main-body text-[16px] font-normal tracking-wide text-stone-700 md:text-[17px]"
        >
          ul. Dąbrowszczaków 21 lok. 3
        </p>

        <p class="font-main-body text-[14px] font-normal text-stone-500 md:text-[15px]">
          10-540 Olsztyn
        </p>
      </div>

      <!-- DIRECTIONS LINK -->
      <a
        href={directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 border border-[var(--brand-gold)] px-5 py-2.5 font-main-body text-[12px] font-normal tracking-wide text-stone-700 transition-colors duration-200 hover:bg-[var(--brand-gold-dark)] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-gold-dark)]"
      >
        <span>Wyznacz trasę</span>
        <span aria-hidden="true" class="text-sm">↗</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* =========================================
     TYTUŁ
     ========================================= */

  .location-title {
    opacity: 0;
    transform: translateY(14px);

    transition:
      opacity 800ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* =========================================
     DIVIDER
     ========================================= */

  .location-divider {
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;

    transition:
      opacity 500ms ease 250ms,
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 250ms;
  }

  /* =========================================
     ELEMENTY SEKCJI
     ========================================= */

  .location-introduction,
  .location-map,
  .location-footer {
    opacity: 0;
    transform: translateY(6px);

    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* =========================================
     KOLEJNOŚĆ POJAWIANIA
     ========================================= */

  .location-introduction {
    transition-delay: 120ms;
  }

  .location-map {
    transition-delay: 220ms;
  }

  .location-footer {
    transition-delay: 320ms;
  }

  /* =========================================
     STAN AKTYWNY
     ========================================= */

  [data-location-section].is-visible .location-title {
    opacity: 1;
    transform: translateY(0);
  }

  [data-location-section].is-visible .location-divider {
    opacity: 1;
    transform: scaleX(1);
  }

  [data-location-section].is-visible .location-introduction,
  [data-location-section].is-visible .location-map,
  [data-location-section].is-visible .location-footer {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================
     REDUKCJA RUCHU
     ========================================= */

  @media (prefers-reduced-motion: reduce) {
    .location-title,
    .location-divider,
    .location-introduction,
    .location-map,
    .location-footer {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>(
    '[data-location-section]'
  );

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (prefersReducedMotion) {
    sections.forEach((section) => {
      section.classList.add('is-visible');
    });
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          const section = entry.target as HTMLElement;

          requestAnimationFrame(() => {
            section.classList.add('is-visible');
          });

          observer.unobserve(section);
        });
      },
      {
        threshold: 0.15,
      }
    );

    sections.forEach((section) => {
      observer.observe(section);
    });
  }
</script>
