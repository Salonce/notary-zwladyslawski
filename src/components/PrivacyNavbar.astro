<nav class="privacy-navbar" aria-label="Nawigacja strony">
  <!-- Dekoracyjne tło -->
  <div class="privacy-navbar-decoration privacy-navbar-decoration-left" aria-hidden="true"></div>
  <div class="privacy-navbar-decoration privacy-navbar-decoration-right" aria-hidden="true"></div>
  <div class="privacy-navbar-center-line" aria-hidden="true"></div>
  <div class="privacy-navbar-top-line" aria-hidden="true"></div>
  <div class="privacy-navbar-bottom-line" aria-hidden="true"></div>

  <!-- Pojedynczy link powrotu -->
  <div class="privacy-navbar-content">
    <a href={import.meta.env.BASE_URL} class="privacy-back-link">
      <span class="privacy-back-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5" />
          <path d="m12 19-7-7 7-7" />
        </svg>
      </span>

      <span class="privacy-back-label">
        Powrót do strony głównej
      </span>
    </a>
  </div>
</nav>

<!-- Rezerwacja miejsca na oba fixed paski -->
<div class="privacy-navbar-spacer" aria-hidden="true"></div>

<style>
  /* =========================================
     NAVBAR — FIXED POD TOPBAR
     ========================================= */

  .privacy-navbar {
    position: fixed;
    top: 30px;
    left: 0;
    right: 0;
    z-index: 50;

    box-sizing: border-box;
    isolation: isolate;
    width: 100%;
    height: 35px;
    min-height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: var(--brand-burgundy);
    border-block: 1px solid rgba(var(--brand-gold-rgb), 0.4);

    font-family: var(--font-top-navbar);
    font-weight: 400;
  }

  /* Dopasowanie do wysokości TopBar na dużych ekranach */
  @media (min-width: 1024px) and (min-height: 900px) {
    .privacy-navbar {
      top: 37px;
    }
  }

  .privacy-navbar a,
  .privacy-navbar span {
    text-shadow: none;
  }

  .privacy-navbar svg {
    filter: none;
  }

  /* =========================================
     MIEJSCE NA FIXED NAVBAR
     ========================================= */

  .privacy-navbar-spacer {
    display: block;
    width: 100%;
    height: 66px;
  }

  @media (min-width: 390px) {
    .privacy-navbar-spacer {
      height: 77px;
    }
  }

  @media (min-width: 1024px) and (min-height: 900px) {
    .privacy-navbar-spacer {
      height: 84px;
    }
  }

  /* =========================================
     DEKORACYJNE TŁO
     ========================================= */

  .privacy-navbar-decoration {
    position: absolute;
    top: 50%;

    width: 380px;
    height: 150px;

    border: 1px solid rgba(var(--brand-gold-rgb), 0.1);
    border-radius: 50%;

    transform: translateY(-50%);
    pointer-events: none;
  }

  .privacy-navbar-decoration-left {
    left: -96px;
  }

  .privacy-navbar-decoration-right {
    right: -96px;
  }

  .privacy-navbar-center-line {
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;

    height: 1px;

    background: rgba(var(--brand-gold-rgb), 0.07);
    transform: translateY(-50%);

    pointer-events: none;
  }

  .privacy-navbar-top-line,
  .privacy-navbar-bottom-line {
    position: absolute;
    left: 0;
    right: 0;

    height: 1px;
    pointer-events: none;
  }

  .privacy-navbar-top-line {
    top: 0;
    background: rgba(var(--brand-gold-rgb), 0.4);
  }

  .privacy-navbar-bottom-line {
    bottom: 0;
    background: rgba(var(--brand-gold-rgb), 0.45);
  }

  /* =========================================
     LINK POWROTU
     ========================================= */

  .privacy-navbar-content {
    position: relative;
    z-index: 10;

    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 35px;
    min-height: 35px;

    align-items: center;
    justify-content: center;

    padding: 0 16px;
  }

  .privacy-back-link {
    position: relative;
    isolation: isolate;

    box-sizing: border-box;
    display: inline-flex;
    min-height: 35px;

    align-items: center;
    justify-content: center;
    gap: 9px;

    padding: 0 20px;

    color: #f7f3eb;
    font-family: inherit;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.045em;

    text-decoration: none;
    white-space: nowrap;

    transition:
      color 250ms ease,
      transform 250ms ease;
  }

  .privacy-back-icon {
    display: flex;
    width: 18px;
    height: 18px;

    flex-shrink: 0;
    align-items: center;
    justify-content: center;

    color: var(--brand-gold);

    transition:
      color 250ms ease,
      transform 250ms ease;
  }

  .privacy-back-icon svg {
    width: 16px;
    height: 16px;
  }

  /* Złota linia pod linkiem */

  .privacy-back-link::after {
    content: "";

    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 5px;

    height: 1px;

    border-radius: 999px;

    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--brand-gold-rgb), 0.9) 22%,
      var(--brand-gold) 50%,
      rgba(var(--brand-gold-rgb), 0.9) 78%,
      transparent
    );

    box-shadow: 0 0 3px rgba(var(--brand-gold-rgb), 0.16);

    transform: scaleX(0);
    transform-origin: center;

    transition:
      transform 280ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  /* =========================================
     OD 390 PX — WYSOKOŚĆ 46 PX
     ========================================= */

  @media (min-width: 390px) {
    .privacy-navbar,
    .privacy-navbar-content {
      height: 46px;
      min-height: 46px;
    }

    .privacy-back-link {
      min-height: 46px;
    }
  }

  /* =========================================
     HOVER — URZĄDZENIA Z MYSZĄ
     ========================================= */

  @media (hover: hover) and (pointer: fine) {
    .privacy-back-link:hover {
      color: var(--brand-gold);
      transform: translateY(-1px);
    }

    .privacy-back-link:hover .privacy-back-icon {
      color: var(--brand-gold);
      transform: translateX(-3px);
    }

    .privacy-back-link:hover::after {
      transform: scaleX(1);
    }
  }

  /* =========================================
     DOTYK
     ========================================= */

  @media (hover: none), (pointer: coarse) {
    .privacy-back-link {
      transition: color 120ms ease;
    }

    .privacy-back-link:active {
      color: var(--brand-gold);
    }

    .privacy-back-link:active .privacy-back-icon {
      color: var(--brand-gold);
    }

    .privacy-back-link:active::after {
      transform: scaleX(0);
    }
  }

  /* =========================================
     FOCUS — DOSTĘPNOŚĆ
     ========================================= */

  .privacy-back-link:focus-visible {
    outline: 2px solid var(--brand-gold);
    outline-offset: -4px;
  }

  /* =========================================
     RESPONSYWNOŚĆ
     ========================================= */

  @media (min-width: 768px) {
    .privacy-back-link {
      gap: 11px;
      padding-inline: 24px;
      font-size: 14px;
    }

    .privacy-back-icon {
      width: 20px;
      height: 20px;
    }

    .privacy-back-icon svg {
      width: 17px;
      height: 17px;
    }
  }

  @media (min-width: 1024px) {
    .privacy-back-link {
      font-size: 15px;
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 480px) {
    .privacy-back-link {
      gap: 8px;
      padding-inline: 12px;
      font-size: 13px;
      letter-spacing: 0.025em;
    }

    .privacy-back-icon {
      width: 17px;
      height: 17px;
    }

    .privacy-back-icon svg {
      width: 15px;
      height: 15px;
    }
  }

  /* =========================================
     OGRANICZENIE ANIMACJI
     ========================================= */

  @media (prefers-reduced-motion: reduce) {
    .privacy-navbar *,
    .privacy-navbar *::before,
    .privacy-navbar *::after {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
  }
</style>
