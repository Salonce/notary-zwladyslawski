<style>
  /* =========================================
     1. GŁÓWNY WYGLĄD STOPKI
  ========================================= */

  .copyright-section {
    width: 100%;
    background-color: var(--copyright-footer-bg);
    border-top: 1px solid rgba(var(--brand-gold-rgb), 0.45);

    /* Rezerwa miejsca na FixedFooter */
    padding-bottom: 60px;
  }

  /* Większe ekrany */
  @media (min-width: 450px) {
    .copyright-section {
      padding-bottom: 70px;
    }
  }

  /* =========================================
     2. LINK DO POLITYKI PRYWATNOŚCI
  ========================================= */

  .privacy-policy-link {
    color: #78716c;
    text-decoration: underline;
    text-decoration-color: rgba(var(--brand-gold-rgb), 0.45);
    text-underline-offset: 4px;
    transition:
      color 300ms ease,
      text-decoration-color 300ms ease;
  }

  .privacy-policy-link:hover {
    color: var(--brand-gold-dark);
    text-decoration-color: var(--brand-gold-dark);
  }

  .privacy-policy-link:focus-visible {
    outline: 2px solid var(--brand-gold-dark);
    outline-offset: 4px;
  }

  /* =========================================
     3. ANIMACJA POJAWIANIA SIĘ STOPKI
  ========================================= */

  .copyright-animated {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copyright-animated.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================
     4. OBSŁUGA OGRANICZONEGO RUCHU
  ========================================= */

  @media (prefers-reduced-motion: reduce) {
    .copyright-animated {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .privacy-policy-link {
      transition: none;
    }
  }
</style>

<script>
  /* =========================================
     5. OBSŁUGA ANIMACJI STOPKI
  ========================================= */

  const copyrightSection = document.querySelector<HTMLElement>(
    '[data-copyright-section]'
  );

  if (copyrightSection) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    if (prefersReducedMotion.matches) {
      copyrightSection.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;

          requestAnimationFrame(() => {
            copyrightSection.classList.add('is-visible');
            observer.disconnect();
          });
        },
        {
          threshold: 0.15,
        }
      );

      observer.observe(copyrightSection);
    }
  }
</script>
