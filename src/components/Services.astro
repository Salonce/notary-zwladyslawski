---
import TitleDivider from './shared/TitleDivider.astro';

type IconName = 'home' | 'family' | 'building' | 'document' | 'award' | 'pen';

interface Category {
  id: string;
  title: string;
  summary: string;
  icon: IconName;
  items: string[];
}

const icons: Record<IconName, string> = {
  home: '<path d="m3 10 9-7 9 7M5.5 9v12h13V9M9 21v-7h6v7" />',
  family:
    '<circle cx="9" cy="8" r="3" /><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 5.2a3 3 0 0 1 0 5.6M18 15a5 5 0 0 1 3 4.6V21" />',
  building:
    '<path d="M3 21h18M5 21V8l7-5 7 5v13M9 10h.01M15 10h.01M9 14h.01M15 14h.01M9 21v-3h6v3" />',
  document:
    '<path d="M7 3h10v18H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3ZM4 18a3 3 0 0 1 3-3h10M9 8h6m-6 3h6" />',
  award:
    '<circle cx="12" cy="10" r="6" /><path d="m9 15-1 6 4-2 4 2-1-6M10 10l1.3 1.3L14 8.5" />',
  pen: '<path d="m4 20 4.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20ZM14.5 6.5l3 3M4 21h16" />',
};

const categories: Category[] = [
  {
    id: 'nieruchomosci',
    title: 'Nieruchomości i prawa do lokali',
    summary: 'Sprzedaż · Darowizna · Dożywocie · Zamiana · Hipoteki · Służebności',
    icon: 'home',
    items: [
      'Sprzedaż',
      'Darowizna',
      'Dożywocie',
      'Zamiana',
      'Zniesienie współwłasności',
      'Umowy deweloperskie',
      'Ustanowienie odrębnej własności lokalu',
      'Ustanowienie hipoteki',
      'Ustanowienie służebności (gruntowej, przesyłu, osobistej)',
    ],
  },
  {
    id: 'rodzinne',
    title: 'Sprawy rodzinne i majątkowe',
    summary: 'Rozdzielność majątkowa · Podział majątku · Obowiązek alimentacyjny',
    icon: 'family',
    items: [
      'Umowa majątkowa małżeńska',
      'Podział majątku wspólnego',
      'Ustalenie obowiązku alimentacyjnego',
    ],
  },
  {
    id: 'spolki',
    title: 'Spółki, działalność gospodarcza i fundacje',
    summary: 'Spółki · Protokoły zgromadzeń · Rejestr akcjonariuszy · Fundacje',
    icon: 'building',
    items: [
      'Zakładanie spółek i zmiany umów spółek',
      'Protokoły zgromadzeń wspólników i walnych zgromadzeń',
      'Rejestr akcjonariuszy',
      'Fundacje',
      'Fundacje rodzinne',
      'Zarząd sukcesyjny',
    ],
  },
  {
    id: 'spadki',
    title: 'Spadki i testamenty',
    summary: 'Testamenty · Dziedziczenie · Poświadczenie dziedziczenia · Dział spadku',
    icon: 'document',
    items: [
      'Sporządzanie testamentów',
      'Wyszukiwanie testamentów',
      'Otwarcie i ogłoszenie testamentu',
      'Przyjęcie spadku',
      'Odrzucenie spadku',
      'Protokół dziedziczenia',
      'Akt poświadczenia dziedziczenia',
      'Europejskie poświadczenie spadkowe',
      'Dział spadku',
      'Zrzeczenie się dziedziczenia',
    ],
  },
  {
    id: 'poswiadczenia',
    title: 'Poświadczenia',
    summary: 'Dokumenty · Podpisy · Daty · Potwierdzenie stanu faktycznego',
    icon: 'award',
    items: [
      'Poświadczenie zgodności dokumentu z oryginałem',
      'Poświadczenie własnoręczności podpisu',
      'Poświadczenie daty okazania dokumentu',
      'Poświadczenie pozostawania osoby przy życiu lub w określonym miejscu',
    ],
  },
  {
    id: 'pozostale',
    title: 'Pozostałe czynności',
    summary: 'Najem · Protokoły · Depozyt · Pełnomocnictwa · Dokumenty',
    icon: 'pen',
    items: [
      'Najem okazjonalny',
      'Najem instytucjonalny',
      'Protokoły z zebrań Wspólnot Mieszkaniowych',
      'Rodzinne ogrody działkowe',
      'Przewłaszczenie nieruchomości na zabezpieczenie',
      'Przeniesienie prawa w celu zwolnienia się z długu',
      'Depozyt notarialny',
      'Pełnomocnictwa',
      'Umowy przedwstępne',
      'Wypisy aktów notarialnych',
      'Odpisy i wyciągi dokumentów',
    ],
  },
];
---

<section
  id="czynnosci-notarialne"
  class="services-area w-full"
  data-services-section
>
  <div class="services-container">

    <!-- NAGŁÓWEK -->
    <div class="text-center">
      <h2
        class="services-title mt-2 font-main-heading text-[34px] font-normal tracking-wide text-black md:text-[40px]"
      >
        Zakres{' '}
        <br class="sm:hidden" />
        czynności notarialnych
      </h2>

      <div class="services-divider">
        <TitleDivider />
      </div>
    </div>

    <!-- KATEGORIE -->
    <div class="services-list mx-auto mt-8 w-full md:mt-10">

      {categories.map((category) => (
        <div class="service-category border-t border-stone-200">
          <div class="flex items-start gap-4 py-5 md:py-6">

            <!-- IKONA -->
            <svg
              class="mt-1 h-[18px] w-[18px] shrink-0 text-[var(--brand-gold-dark)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[category.icon]}
            />

            <div class="min-w-0 flex-1 md:flex md:items-center md:justify-between md:gap-4">

              <div class="min-w-0">
                <h3
                  id={`services-title-${category.id}`}
                  class="font-notarial-services-list-main-element text-[18px] font-normal tracking-wide text-stone-800 md:text-[20px]"
                >
                  {category.title}
                </h3>

                <p class="mt-1 font-main-body text-[12px] leading-[1.5] text-stone-500 md:text-[13px]">
                  {category.summary}
                </p>
              </div>

              <!-- PRZYCISK ROZWIJANIA -->
              <button
                type="button"
                class="button-accent service-toggle mt-4 inline-flex shrink-0 items-center gap-2 border px-4 py-2 font-main-body text-[11px] uppercase tracking-[0.12em] md:mt-0"
                aria-expanded="false"
                aria-controls={`services-${category.id}`}
              >
                <span class="service-toggle-label">Pokaż czynności</span>
                <span class="sr-only">– {category.title}</span>

                <span class="relative -top-px text-[15px] leading-none">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="service-chevron h-3.5 w-3.5"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <!-- LISTA CZYNNOŚCI -->
          <div
            id={`services-${category.id}`}
            class="service-panel"
            role="region"
            aria-labelledby={`services-title-${category.id}`}
            aria-hidden="true"
            inert
          >
            <div class="service-panel-inner">
              <ul class="grid gap-x-10 pb-6 pl-5 md:grid-cols-2 md:pb-7">
                {category.items.map((item) => (
                  <li class="service-item">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}

      <div class="border-t border-stone-200"></div>

    </div>
  </div>

  <!-- Fallback bez JavaScriptu: treść ma być widoczna -->
  <noscript>
    <style is:inline>
      .services-title,
      .services-divider,
      .services-list {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</section>

<style>
  /* =========================================
     ANIMACJA POJAWIANIA SIĘ
     IDENTYCZNA JAK W SEKCJI OPŁATY
  ========================================= */

  .services-title {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 800ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .services-divider {
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
    transition:
      opacity 500ms ease 250ms,
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 250ms;
  }

  .services-list {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 140ms;
  }

  [data-services-section].is-visible .services-title {
    opacity: 1;
    transform: translateY(0);
  }

  [data-services-section].is-visible .services-divider {
    opacity: 1;
    transform: scaleX(1);
  }

  [data-services-section].is-visible .services-list {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================
     PODSTAWOWY WYGLĄD
  ========================================= */

  .services-area {
    width: 100%;
    box-sizing: border-box;
    padding: 0 24px;
  }

  .services-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .services-list {
    max-width: 1024px;
  }

  .service-category {
    transition: background-color 300ms ease;
  }

  .service-category:hover {
    background-color: rgba(var(--brand-gold-rgb), 0.025);
  }

  .service-item {
    position: relative;
    padding: 4px 0 4px 14px;
    font-family: var(--font-main-body);
    font-size: 14px;
    line-height: 1.45;
    color: rgb(87 83 78);
    list-style: none;
  }

  .service-item::before {
    position: absolute;
    top: 0.8em;
    left: 1px;
    width: 6px;
    height: 6px;
    border: 1px solid rgba(111, 91, 47, 0.65);
    content: '';
    transform: rotate(45deg);
  }

  /* =========================================
     ROZWIJANIE KATEGORII
     (grid 0fr -> 1fr: animacja do dokładnej wysokości)
  ========================================= */

  .service-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 420ms ease,
      opacity 420ms ease;
  }

  .service-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .service-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .service-chevron {
    transition: transform 250ms ease;
  }

  .service-toggle[aria-expanded="true"] .service-chevron {
    transform: rotate(180deg);
  }

  @media (max-width: 1100px) {
    .services-area {
      padding: 0 30px;
    }
  }

  @media (max-width: 768px) {
    .services-area {
      padding: 0 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-title,
    .services-divider,
    .services-list,
    .service-panel,
    .service-chevron,
    .service-category {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const servicesSection = document.querySelector<HTMLElement>(
    '[data-services-section]'
  );

  if (servicesSection) {
    // =========================================
    // OBSŁUGA ROZWIJANIA KATEGORII
    // =========================================

    const toggleButtons = Array.from(
      servicesSection.querySelectorAll<HTMLButtonElement>('.service-toggle')
    );

    const setOpen = (button: HTMLButtonElement, open: boolean) => {
      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      const label = button.querySelector<HTMLElement>('.service-toggle-label');

      button.setAttribute('aria-expanded', String(open));

      if (label) {
        label.textContent = open ? 'Ukryj czynności' : 'Pokaż czynności';
      }

      if (panel) {
        panel.classList.toggle('is-open', open);
        panel.setAttribute('aria-hidden', String(!open));

        if (open) {
          panel.removeAttribute('inert');
        } else {
          panel.setAttribute('inert', '');
        }
      }
    };

    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const wasOpen = button.getAttribute('aria-expanded') === 'true';

        // Akordeon: zawsze zamykamy wszystkie, otwieramy tylko klikniętą
        toggleButtons.forEach((other) => setOpen(other, false));

        if (!wasOpen) {
          setOpen(button, true);
        }
      });
    });

    // =========================================
    // ANIMACJA POJAWIANIA SIĘ SEKCJI
    // =========================================

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    if (prefersReducedMotion.matches || !('IntersectionObserver' in window)) {
      servicesSection.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;

          requestAnimationFrame(() => {
            servicesSection.classList.add('is-visible');
            observer.disconnect();
          });
        },
        { threshold: 0.15 }
      );

      observer.observe(servicesSection);
    }
  }
</script>