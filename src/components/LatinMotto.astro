<!-- MOTTO -->
<section
  id="motto"
  class="motto-section scroll-mt-24 w-full min-w-0 overflow-visible pt-20 pb-20 md:pt-24 md:pb-24"
  data-motto-section
>
  <div class="mx-auto w-full min-w-0 px-3 text-center sm:px-6 md:px-10">

    <!-- GÓRNY ORNAMENT -->
    <div
      class="motto-ornament motto-ornament-top mx-auto flex w-full max-w-xl min-w-0 items-center justify-center gap-2 sm:gap-3"
      aria-hidden="true"
    >
      <div class="flex min-w-0 flex-1 items-center justify-end">
        <span
          class="motto-ornament-line motto-ornament-line-left h-px min-w-0 flex-1"
        ></span>
        <span
          class="motto-ornament-symbol motto-leaf-top -ml-[3px] shrink-0 text-[14px] leading-none sm:text-[15px]"
        >
          &#x2767;
        </span>
      </div>

      <span class="motto-ornament-symbol shrink-0 text-[10px]">
        &#x2726;
      </span>

      <div class="flex min-w-0 flex-1 items-center justify-start">
        <span
          class="motto-ornament-symbol motto-ornament-symbol-right motto-leaf-top -mr-[3px] shrink-0 text-[14px] leading-none sm:text-[15px]"
        >
          &#x2767;
        </span>
        <span
          class="motto-ornament-line motto-ornament-line-right h-px min-w-0 flex-1"
        ></span>
      </div>
    </div>

    <!-- NAPIS -->
    <p
      class="latin-quote motto-quote mx-auto my-6 w-full min-w-0 whitespace-normal break-words font-motto text-[clamp(14px,4.3vw,25px)] leading-relaxed tracking-[0.06em] sm:whitespace-nowrap sm:text-[25px] md:my-7 md:text-[34px] lg:text-[38px]"
      aria-label="LEX EST QUOD NOTAMUS"
    >
      <span>L</span><span>E</span><span>X</span>
      <span>&nbsp;</span>
      <span>E</span><span>S</span><span>T</span>
      <span>&nbsp;</span>
      <span>Q</span><span>U</span><span>O</span><span>D</span>
      <span>&nbsp;</span>
      <span>N</span><span>O</span><span>T</span><span>A</span><span>M</span><span>U</span><span>S</span>
    </p>

    <!-- DOLNY ORNAMENT -->
    <div
      class="motto-ornament motto-ornament-bottom mx-auto flex w-full max-w-xl min-w-0 items-center justify-center gap-2 sm:gap-3"
      aria-hidden="true"
    >
      <div class="flex min-w-0 flex-1 items-center justify-end">
        <span
          class="motto-ornament-line motto-ornament-line-left h-px min-w-0 flex-1"
        ></span>
        <span
          class="motto-ornament-symbol -ml-[3px] shrink-0 text-[14px] leading-none sm:text-[15px]"
        >
          &#x2767;
        </span>
      </div>

      <span class="motto-ornament-symbol shrink-0 text-[10px]">
        &#x2726;
      </span>

      <div class="flex min-w-0 flex-1 items-center justify-start">
        <span
          class="motto-ornament-symbol motto-ornament-symbol-right -mr-[3px] shrink-0 text-[14px] leading-none sm:text-[15px]"
        >
          &#x2767;
        </span>
        <span
          class="motto-ornament-line motto-ornament-line-right h-px min-w-0 flex-1"
        ></span>
      </div>
    </div>

  </div>
</section>

<style>
  /* ========================================
     ORYGINALNE STYLE MOTTO
  ======================================== */

  .latin-quote {
    position: relative;
    isolation: isolate;
    color: var(--brand-gold-motto);
  }

  .motto-ornament-line {
    box-shadow:
      0 -1px 0 rgba(255, 252, 239, 0.32),
      0 1px 1px rgba(78, 56, 17, 0.2);
  }

  .motto-ornament-line-left {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(var(--brand-gold-rgb), 0.42) 38%,
      #a9822f 100%
    );
  }

  .motto-ornament-line-right {
    background: linear-gradient(
      270deg,
      transparent 0%,
      rgba(var(--brand-gold-rgb), 0.42) 38%,
      #a9822f 100%
    );
  }

  .motto-ornament-symbol {
    color: #8f702f;
    text-shadow: none;
  }

  /* Odbicie pionowe górnych liści */
  .motto-leaf-top {
    transform: scaleY(-1);
  }

  /* Odbicie górnego prawego liścia */
  .motto-leaf-top.motto-ornament-symbol-right {
    transform: scale(-1, -1);
  }

  .motto-ornament-symbol-right {
    transform: scaleX(-1);
  }

  /* Złote litery */
  .latin-quote span {
    display: inline-block;
    font-weight: 400;
    color: #8f702f;
    background-image: linear-gradient(
      180deg,
      #e5c04b 0%,
      #c99a1c 24%,
      #ffdf70 48%,
      #b78308 72%,
      #e2b93a 100%
    );

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0.4px rgba(91, 62, 10, 0.76);

    text-shadow:
      -1px -1px 0 rgba(255, 250, 228, 0.7),
      1px 1px 0 rgba(67, 48, 18, 0.6),
      0 2px 2px rgba(78, 56, 17, 0.58),
      0 4px 7px rgba(78, 56, 17, 0.38),
      0 7px 10px rgba(78, 56, 17, 0.14);
  }

  /* ========================================
     ANIMACJA MOTTO
     Taka sama zasada jak w "Przed wizytą"
  ======================================== */

  /* GÓRNY ORNAMENT */
  .motto-ornament-top {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* NAPIS */
  .motto-quote {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 800ms ease,
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 140ms;
  }

  /* DOLNY ORNAMENT */
  .motto-ornament-bottom {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 280ms;
  }

  /* STAN WIDOCZNY */
  .motto-section.is-visible .motto-ornament-top {
    opacity: 1;
    transform: translateY(0);
  }

  .motto-section.is-visible .motto-quote {
    opacity: 1;
    transform: translateY(0);
  }

  .motto-section.is-visible .motto-ornament-bottom {
    opacity: 1;
    transform: translateY(0);
  }

  /* REDUKCJA ANIMACJI */
  @media (prefers-reduced-motion: reduce) {
    .motto-ornament-top,
    .motto-quote,
    .motto-ornament-bottom {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const mottoSection = document.querySelector<HTMLElement>(
    '[data-motto-section]'
  );

  if (mottoSection) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    if (prefersReducedMotion.matches) {
      mottoSection.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;

          requestAnimationFrame(() => {
            mottoSection.classList.add('is-visible');
            observer.disconnect();
          });
        },
        {
          threshold: 0.15,
        }
      );

      observer.observe(mottoSection);
    }
  }
</script>
