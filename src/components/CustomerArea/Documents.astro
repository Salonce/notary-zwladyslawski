
---
import TitleDivider from '../shared/TitleDivider.astro';

const documents = [
  {
    title: 'Formularz danych osobowych',
    href: '/documents/formularz-danych-osobowych.docx',
    filename: 'formularz-danych-osobowych.docx',
    ariaLabel: 'Pobierz formularz danych osobowych',
    action: 'Pobierz',
    type: 'download',
  },
  {
    title: 'Umowa przeniesienia praw do działki',
    href: 'http://pzd.pl/wzory-dokumentow.html',
    ariaLabel: 'Otwórz wzory dokumentów PZD',
    action: 'Otwórz',
    type: 'external',
  },
  {
    title: 'Umowa sprzedaży udziału(ów) w Sp. z o.o.',
    href: '/documents/umowa-sprzedazy-udzialow.docx',
    filename: 'umowa-sprzedazy-udzialow.docx',
    ariaLabel: 'Pobierz umowę sprzedaży udziałów',
    action: 'Pobierz',
    type: 'download',
  },
  {
    title: 'Umowa darowizny udziału(ów) w Sp. z o.o.',
    href: '/documents/umowa-darowizny-udzialow.docx',
    filename: 'umowa-darowizny-udzialow.docx',
    ariaLabel: 'Pobierz umowę darowizny udziałów',
    action: 'Pobierz',
    type: 'download',
  },
  {
    title: 'Zgoda na wyjazd dziecka za granicę',
    subtitle: 'POL / ANG / UKR',
    href: '/documents/zgoda-na-podroz-maloletniego-dziecka-en_pl_ua.docx',
    filename: 'zgoda-na-podroz-maloletniego-dziecka-en_pl_ua.docx',
    ariaLabel: 'Pobierz zgodę na wyjazd dziecka za granicę w językach polskim, angielskim i ukraińskim',
    action: 'Pobierz',
    type: 'download',
  },
  {
    title: 'Zgoda na wyjazd dziecka za granicę',
    subtitle: 'POL / ANG / RU',
    href: '/documents/zgoda-na-podroz-maloletniego-dziecka-en_pl_ru.docx',
    filename: 'zgoda-na-podroz-maloletniego-dziecka-en_pl_ru.docx',
    ariaLabel: 'Pobierz zgodę na wyjazd dziecka za granicę w językach polskim, angielskim i rosyjskim',
    action: 'Pobierz',
    type: 'download',
  },
  {
    title: 'Najem okazjonalny',
    href: '/documents/umowa-najmu-okazjonalnego.docx',
    filename: 'umowa-najmu-okazjonalnego.docx',
    ariaLabel: 'Pobierz umowę najmu okazjonalnego',
    action: 'Pobierz',
    type: 'download',
  },
];
---

<section class="documents content-column">

  <!-- HEADER -->
  <div class="text-center">
    <h2
      class="documents-title mt-2 font-main-heading text-[34px] tracking-wide md:text-[40px]"
    >
      Dokumenty do pobrania
    </h2>

    <div class="documents-divider">
      <TitleDivider />
    </div>
  </div>

  <!-- INTRO -->
  <div
    class="documents-intro mx-auto mt-7 max-w-3xl text-justify font-main-body text-[17px] leading-[1.85] text-stone-600 md:mt-8 md:text-[18px] md:leading-[1.9]"
  >
    <p>
      Poniżej udostępniamy dokumenty pomocne w przygotowaniu do wybranych czynności notarialnych.
      Ich zakres zależy od okoliczności konkretnej sprawy.
    </p>
  </div>

  <!-- DOCUMENT LIST -->
  <div
    class="documents-list mx-auto mt-7 max-w-3xl font-main-body"
  >
    <div class="flex w-full flex-col">
      {documents.map((document) => (
        <div
          class="group flex w-full items-center gap-3 border-b border-[var(--brand-gold)]/35 py-3 md:py-3.5"
        >
          <!-- DOCUMENT ICON -->
          <span
            class="flex h-6 w-6 shrink-0 items-center justify-center text-[var(--brand-gold-dark)]"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 2.5h9.5L19 7v18.5H5z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14.5 2.5V7H19"
              />
              <path
                stroke-linecap="round"
                d="M8 11h8M8 14.5h8M8 18h5.5"
              />
            </svg>
          </span>

          <!-- DOCUMENT NAME -->
          <span
            class="min-w-0 flex-1 font-main-body text-[14px] leading-[1.35] text-stone-800 md:text-[15px]"
          >
            {document.title}
            {document.subtitle && (
              <>
                <br />
                {document.subtitle}
              </>
            )}
          </span>

          <!-- ACTION -->
          <a
            href={document.href}
            download={document.type === 'download' ? document.filename : undefined}
            target={document.type === 'external' ? '_blank' : undefined}
            rel={document.type === 'external' ? 'noopener noreferrer' : undefined}
            aria-label={document.ariaLabel}
            class="button-accent inline-flex shrink-0 items-center gap-1.5 rounded-md border px-2.5 py-1.5 font-main-body text-[9px] uppercase tracking-[0.13em] no-underline md:px-3"
          >
            <span>{document.action}</span>

            {document.type === 'download' ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                class="h-3.5 w-3.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" d="M12 3v11" />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m7 10 5 5 5-5"
                />
                <path stroke-linecap="round" d="M5 20h14" />
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-3.5 w-3.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M14 5h5v5"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 5l-8 8"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
                />
              </svg>
            )}
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- CLOSING TEXT -->
  <div class="documents-closing mx-auto mt-6 max-w-3xl pt-1 font-main-body">
    <p class="text-justify text-[17px] leading-[1.85] md:text-[18px] md:leading-[1.9]">
      Zachęcamy do pobrania, uzupełnienia i odesłania dokumentów na adres e-mail kancelarii.
      Pozwoli to na wcześniejsze przygotowanie czynności i sprawniejszą wizytę.
    </p>
  </div>

  <!-- INFORMATION -->
  <div class="documents-information mx-auto mt-3 max-w-3xl font-main-body">
    <p class="text-justify text-[17px] leading-[1.85] md:text-[18px] md:leading-[1.9]">
      Informacje o dokumentach wymaganych do pozostałych czynności uzyskają Państwo w kancelarii,
      telefonicznie lub drogą elektroniczną, po przedstawieniu okoliczności sprawy.
    </p>
  </div>

</section>

<style>
  /* SVG I LINKI */
  .documents a::before,
  .documents a::after,
  .documents li::before,
  .documents li::after,
  .documents li::marker {
    content: none !important;
    display: none !important;
  }

  .documents a {
    list-style: none !important;
  }

  .documents svg {
    display: block;
    flex-shrink: 0;
  }

  /* ANIMACJE */
  .documents-title,
  .documents-divider,
  .documents-intro,
  .documents-list,
  .documents-closing,
  .documents-information {
    animation: documents-enter 650ms ease both;
  }

  .documents-title {
    animation-duration: 800ms;
    animation-delay: 0ms;
  }

  .documents-divider {
    animation: documents-divider-enter 900ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
    transform-origin: center;
  }

  .documents-intro {
    animation-delay: 120ms;
  }

  .documents-list {
    animation-delay: 210ms;
  }

  .documents-closing {
    animation-delay: 300ms;
  }

  .documents-information {
    animation-delay: 390ms;
  }

  @keyframes documents-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes documents-divider-enter {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .documents-title,
    .documents-divider,
    .documents-intro,
    .documents-list,
    .documents-closing,
    .documents-information {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
