# Resend API key – wstaw swój klucz w lokalnym .env
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Adres nadawcy – domena musi być zweryfikowana w Resend
MAIL_FROM=kontakt@example.pl

# Adres odbiorcy – skrzynka kancelarii
MAIL_TO=kontakt@example.pl

# Dozwolony adres frontendowej strony
ALLOWED_ORIGIN=http://localhost:4321